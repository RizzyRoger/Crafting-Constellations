rules_version = '2';

// Crafting Constellations — Firestore rules
//
// Principles:
// - Every piece of user writing is created `pending`; only Cloud Functions
//   publish, hold, or remove it, and only functions attach author names and
//   the licensed mark. Clients can never forge either.
// - Readers see published items plus their own. Queries must filter on
//   status == 'published' or authorUid == me to be provable.
// - Profiles, counters, queues, bans and audit logs are written by functions.
// - Emails never live in Firestore.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // A missing claim must read as false, not as an error
    function claim(k) { return request.auth.token.get(k, false); }
    function isAdmin() { return signedIn() && claim('admin') == true; }
    function verified() { return signedIn() && claim('email_verified') == true; }
    // The bans doc is authoritative even while an old ID token is still valid
    function notBanned() {
      return claim('banned') != true
        && !exists(/databases/$(database)/documents/bans/$(me()));
    }
    function canWrite() { return signedIn() && notBanned(); }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(me())); }
    function isMember(gid) {
      return exists(/databases/$(database)/documents/groups/$(gid)/members/$(me()));
    }
    function postPublished(gid, pid) {
      return get(/databases/$(database)/documents/groups/$(gid)/posts/$(pid)).data.status == 'published';
    }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Ids of new writing: letters and digits, as addDoc makes them (20 of them). Functions
    // join a path's ids with '~' for its queue and notice ids, so a post named
    // 'P~comments~C' would take over comment C's review entry and its reports, and a
    // long one would make ids over Firestore's 1500 bytes: never reported, nor replied to.
    function plainId(id) { return id.matches('^[A-Za-z0-9]{1,40}$'); }
    function nd() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // New writing: caller is the author, starts pending, server time, and
    // only whitelisted keys (so author / heldReason / counters can't be set).
    function newContent(allowed, required) {
      return nd().keys().hasOnly(allowed)
        && nd().keys().hasAll(required)
        && nd().authorUid == me()
        && nd().status == 'pending'
        && nd().createdAt == request.time;
    }
    // Optional @mentions: the uids the writer picked (up to 10, as MAX_MENTIONS).
    // Functions check each one before anyone is pinged; clients never set `mentioned`.
    function mentionsOk() {
      return !('mentions' in nd())
        || (nd().mentions is list && nd().mentions.size() >= 1 && nd().mentions.size() <= 10);
    }
    function visible() {
      return resource.data.status == 'published' || resource.data.authorUid == me();
    }
    // The only client change to writing: the author withdraws it
    function isWithdrawal() {
      return resource.data.authorUid == me()
        && resource.data.status in ['pending', 'published', 'held']
        && changed().hasOnly(['status'])
        && nd().status == 'withdrawn';
    }

    // ---------- profiles ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;                      // saveProfile + admin callables only

      match /private/{docId} {
        allow read: if signedIn() && me() == uid;
        allow create, update: if canWrite() && me() == uid && docId == 'settings'
          && nd().keys().hasOnly(['crisisRegion', 'reduceMotion', 'dmLastRead'])
          && (!('crisisRegion' in nd()) || nd().crisisRegion in ['US', 'UK', 'IE', 'CA', 'AU', 'other'])
          && (!('reduceMotion' in nd()) || nd().reduceMotion is bool)
          && (!('dmLastRead' in nd()) || (nd().dmLastRead is map && nd().dmLastRead.size() <= 200));
        allow delete: if false;
      }

      match /notices/{nid} {
        allow read: if signedIn() && me() == uid;
        allow update: if signedIn() && me() == uid
          && changed().hasOnly(['seen']) && nd().seen == true;
        allow create, delete: if false;
      }
    }

    match /penNames/{name}      { allow read, write: if false; }
    match /constellations/{cid} { allow read: if signedIn(); allow write: if false; }

    // ---------- groups ----------
    match /groups/{gid} {
      allow read: if signedIn();
      allow write: if false;                      // createGroup callable; memberCount by trigger

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if canWrite() && memberUid == me() && hasProfile()
          && nd().keys().hasOnly(['uid', 'joinedAt'])
          && nd().uid == me()
          && nd().joinedAt == request.time
          && exists(/databases/$(database)/documents/groups/$(gid));
        allow delete: if canWrite() && memberUid == me();
        allow update: if false;
      }

      match /messages/{mid} {
        allow read: if signedIn() && (isAdmin() || (isMember(gid) && visible()));
        allow create: if canWrite() && verified() && plainId(mid) && isMember(gid)
          && newContent(['authorUid', 'text', 'status', 'createdAt', 'mentions'],
                        ['authorUid', 'text', 'status', 'createdAt'])
          && isStr(nd().text, 1, 1000) && mentionsOk();
        allow update: if canWrite() && isWithdrawal();
        allow delete: if false;
      }

      match /posts/{pid} {
        allow read: if signedIn() && (isAdmin() || (isMember(gid) && visible()));
        allow create: if canWrite() && verified() && plainId(pid) && isMember(gid)
          && newContent(['authorUid', 'title', 'body', 'status', 'createdAt', 'mentions'],
                        ['authorUid', 'body', 'status', 'createdAt'])
          && isStr(nd().body, 1, 4000)
          && (!('title' in nd()) || isStr(nd().title, 1, 120))
          && mentionsOk();
        allow update: if canWrite() && isWithdrawal();
        allow delete: if false;

        match /comments/{cid} {
          allow read: if signedIn() && (isAdmin() || (isMember(gid) && visible()));
          allow create: if canWrite() && verified() && plainId(cid) && isMember(gid) && postPublished(gid, pid)
            && newContent(['authorUid', 'text', 'status', 'createdAt', 'mentions'],
                          ['authorUid', 'text', 'status', 'createdAt'])
            && isStr(nd().text, 1, 1000) && mentionsOk();
          allow update: if canWrite() && isWithdrawal();
          allow delete: if false;
        }

        // Doc id = liker uid, so one like per person
        match /likes/{likerUid} {
          allow read: if signedIn() && (isAdmin() || isMember(gid));
          allow create: if canWrite() && verified() && likerUid == me() && isMember(gid) && postPublished(gid, pid)
            && nd().keys().hasOnly(['uid', 'createdAt'])
            && nd().uid == me()
            && nd().createdAt == request.time;
          allow delete: if canWrite() && likerUid == me();
          allow update: if false;
        }
      }
    }

    // collectionGroup('members').where('uid', '==', X) → the groups of person X
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn();
    }

    // ---------- connections ----------
    match /connections/{pairId} {
      // Lists can't bind {pairId}; query with uids array-contains me
      allow read: if signedIn() && me() in resource.data.uids;
      allow create: if canWrite() && hasProfile()
        && nd().requester == me()
        && nd().recipient is string && nd().recipient != me()
        && nd().uids is list && nd().uids.size() == 2
        && nd().uids[0] < nd().uids[1]
        && me() in nd().uids && nd().recipient in nd().uids
        && pairId == nd().uids[0] + '_' + nd().uids[1]
        && nd().createdAt == request.time && nd().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(nd().recipient)) && (
          // reach out
          (verified() && nd().status == 'pending'
            && nd().keys().hasOnly(['uids', 'requester', 'recipient', 'status', 'createdAt', 'updatedAt']))
          // block outright, with no connection yet (a stranger who keeps pinging you): no
          // confirmed email needed, and only the fields any other block has
          || (nd().status == 'blocked' && nd().blockedBy == me()
            && nd().keys().hasOnly(['uids', 'requester', 'recipient', 'status', 'blockedBy', 'createdAt', 'updatedAt']))
        );
      allow update: if canWrite() && me() in resource.data.uids && nd().updatedAt == request.time && (
          // accept: recipient only
          (verified() && resource.data.status == 'pending' && resource.data.recipient == me()
            && nd().status == 'accepted' && changed().hasOnly(['status', 'updatedAt']))
          // block: either person, from any state but blocked
          || (resource.data.status != 'blocked' && nd().status == 'blocked' && nd().blockedBy == me()
            && changed().hasOnly(['status', 'blockedBy', 'updatedAt']))
        );
      // decline / cancel / disconnect / unblock (only the blocker can lift a block)
      allow delete: if canWrite() && me() in resource.data.uids
        && (resource.data.status != 'blocked' || resource.data.blockedBy == me());
    }

    // Accepted connections only, mirrored by a function for the constellation
    match /friendships/{pairId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- private messages ----------
    match /dms/{pairId} {
      function isParticipant() {
        return signedIn() && pairId.split('_').size() == 2 && me() in pairId.split('_');
      }
      allow get: if verified() && isParticipant();
      allow list: if verified() && me() in resource.data.uids;
      allow write: if false;                      // thread doc maintained by functions

      match /messages/{mid} {
        allow read: if verified() && isParticipant() && visible();
        allow create: if canWrite() && verified() && plainId(mid) && isParticipant()
          && get(/databases/$(database)/documents/connections/$(pairId)).data.status == 'accepted'
          && newContent(['authorUid', 'text', 'status', 'createdAt'],
                        ['authorUid', 'text', 'status', 'createdAt'])
          && isStr(nd().text, 1, 1000);
        allow update: if canWrite() && isParticipant() && isWithdrawal();
        allow delete: if false;
      }
    }

    // ---------- private group chats ----------
    // Made by the createChat function from the creator's accepted connections
    match /chats/{chatId} {
      // Lists can't bind {chatId}; query with uids array-contains me
      allow read: if verified() && me() in resource.data.uids;
      // Leave: take only yourself off the list
      allow update: if canWrite() && me() in resource.data.uids
        && changed().hasOnly(['uids'])
        && nd().uids == resource.data.uids.removeAll([me()]);
      allow create, delete: if false;

      match /messages/{mid} {
        function inChat() {
          return me() in get(/databases/$(database)/documents/chats/$(chatId)).data.uids;
        }
        allow read: if verified() && inChat() && visible();
        allow create: if canWrite() && verified() && plainId(mid) && inChat()
          && newContent(['authorUid', 'text', 'status', 'createdAt', 'mentions'],
                        ['authorUid', 'text', 'status', 'createdAt'])
          && isStr(nd().text, 1, 1000) && mentionsOk();
        allow update: if canWrite() && inChat() && isWithdrawal();
        allow delete: if false;
      }
    }

    // ---------- reports ----------
    match /reports/{rid} {
      allow create: if canWrite()
        && nd().keys().hasOnly(['reporterUid', 'contentPath', 'reason', 'details', 'createdAt'])
        && nd().keys().hasAll(['reporterUid', 'contentPath', 'reason', 'createdAt'])
        && nd().reporterUid == me()
        && nd().contentPath is string
        && nd().contentPath.matches('^(groups/[^/]+/posts/[^/]+(/comments/[^/]+)?|groups/[^/]+/messages/[^/]+|dms/[^/]+/messages/[^/]+|chats/[^/]+/messages/[^/]+|users/[^/]+)$')
        && nd().reason in ['harassment', 'hate', 'selfHarm', 'spam', 'personalInfo', 'impersonation', 'other']
        && (!('details' in nd()) || isStr(nd().details, 0, 500))
        && nd().createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- professional applications ----------
    // A slot, or a reapplication's slot in the folder named for the decision it answers
    // (storage.rules); the folder is a whole millisecond count
    function docName(f) { return f is string && f.matches('([0-9]{1,16}/)?doc-[1-5]'); }
    function appFieldsValid() {
      let d = nd();
      return isStr(d.legalName, 2, 120)
        && d.licenseType in ['psychologist', 'psychiatrist', 'counselor', 'socialWorker',
                             'marriageFamilyTherapist', 'psychiatricNurse', 'other']
        && isStr(d.licenseRegion, 2, 80)
        && isStr(d.licenseNumber, 2, 60)
        && d.files is list && d.files.size() >= 1 && d.files.size() <= 5
        // Rules can't loop, so each of the five places is checked in turn
        && docName(d.files[0])
        && (d.files.size() < 2 || docName(d.files[1]))
        && (d.files.size() < 3 || docName(d.files[2]))
        && (d.files.size() < 4 || docName(d.files[3]))
        && (d.files.size() < 5 || docName(d.files[4]))
        && (!('statement' in d) || isStr(d.statement, 0, 1000))
        && d.status == 'submitted'
        && d.submittedAt == request.time;
    }

    match /proApplications/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create: if canWrite() && verified() && me() == uid && hasProfile()
        && nd().keys().hasOnly(['uid', 'status', 'legalName', 'licenseType', 'licenseRegion',
                                'licenseNumber', 'files', 'statement', 'submittedAt'])
        && nd().uid == me()
        && appFieldsValid();
      // A resubmission replaces the doc, so it drops the last review's fields;
      // it may clear them but never set them
      allow update: if canWrite() && verified() && me() == uid
        && resource.data.status in ['submitted', 'denied', 'revoked']
        && changed().hasOnly(['status', 'legalName', 'licenseType', 'licenseRegion',
                              'licenseNumber', 'files', 'statement', 'submittedAt',
                              'reviewedAt', 'reviewedBy', 'reviewNote'])
        && !nd().keys().hasAny(['reviewedAt', 'reviewedBy', 'reviewNote'])
        && appFieldsValid();
      allow delete: if false;
    }

    // ---------- calls (local backend) ----------
    // While Cloud Functions are unavailable, the site writes callable requests
    // here and a backend on our own machine answers them in the same doc.
    // authTime must match the caller's token, so the backend can trust it
    // (deleteAccount needs a recent sign-in); everything else it reads from Auth.
    match /calls/{callId} {
      allow create: if signedIn()
        && nd().keys().hasOnly(['uid', 'name', 'data', 'authTime', 'state', 'createdAt'])
        && nd().uid == me()
        && nd().name in ['saveProfile', 'deleteAccount', 'approveContent', 'removeContent', 'banUser',
                         'unbanUser', 'reviewProfessional', 'setAdmin', 'bootstrapAdmin', 'createGroup',
                         'createChat']
        && nd().data is map && nd().data.size() <= 10
        && nd().authTime == request.auth.token.auth_time
        && nd().state == 'new'
        && nd().createdAt == request.time;
      allow get, delete: if signedIn() && resource.data.uid == me();
      allow list, update: if false;
    }

    // ---------- admin-only ----------
    match /rateLimits/{uid}   { allow read, write: if false; }
    match /modQueue/{qid}     { allow read: if isAdmin(); allow write: if false; }
    match /bans/{uid}         { allow read: if isAdmin(); allow write: if false; }
    match /adminActions/{id}  { allow read: if isAdmin(); allow write: if false; }
  }
}
