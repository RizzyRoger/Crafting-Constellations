# Copy to .env.local and fill from Firebase console → Project settings → Your apps → Web app.
# .env.local is used by `npm run build` (deploys) and `npm run dev:live`; plain `npm run dev`
# always uses the emulators (.env.development wins over .env.local in development mode).
VITE_USE_EMULATORS=false
# true while the project can't run Cloud Functions (no Blaze): calls go to the local backend
# (functions/src/local-backend.ts) through Firestore, and licence uploads are paused
VITE_LOCAL_BACKEND=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Appears in the config once Google Analytics is enabled for the project. Empty = no Analytics/Performance.
VITE_FIREBASE_MEASUREMENT_ID=
# Optional. reCAPTCHA v3 site key for Firebase App Check. Empty = no App Check (always off on the emulators).
VITE_APPCHECK_SITE_KEY=

# The App Check debug token is a secret that bypasses App Check. Put it in .env.live.local
# (read only by `npm run dev:live`, never by builds), not here:
# VITE_APPCHECK_DEBUG_TOKEN=
