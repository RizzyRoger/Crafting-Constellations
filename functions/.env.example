# Copy to functions/.env.<project-id> (gitignored: it holds people's emails).
# The Firebase CLI loads it on deploy; the emulator reads functions/.env.local instead.

# Verified accounts with these emails may make themselves a moderator ("I'm on the moderator list")
ADMIN_EMAILS=
# Callables refuse requests without a valid App Check token when true.
# Leave false until App Check metrics show ~98%+ verified requests.
ENFORCE_APP_CHECK=false
