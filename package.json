{
  "name": "crafting-constellations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-crafting-constellations \"vitest run --config vitest.rules.config.ts\"",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-crafting-constellations",
    "seed": "tsx scripts/seed.ts",
    "grant-admin": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.33.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
