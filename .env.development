# Local development against the Firebase Emulator Suite (offline demo project).
# A mode file wins over .env.local only for the keys it sets, so this one sets every key in .env.example:
# `npm run dev` is always the emulators, and callables go to the Functions emulator.
# To try local-backend mode on the emulators, put VITE_LOCAL_BACKEND=true in .env.development.local
# (README, "Without Blaze"). For the real project use `npm run dev:live` (reads .env.local + .env.live.local).
VITE_USE_EMULATORS=true
VITE_LOCAL_BACKEND=false
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-crafting-constellations.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-crafting-constellations
VITE_FIREBASE_STORAGE_BUCKET=demo-crafting-constellations.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Analytics, Performance and App Check never run on the emulators
VITE_FIREBASE_MEASUREMENT_ID=
VITE_APPCHECK_SITE_KEY=
