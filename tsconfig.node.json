{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "@moderation": ["./functions/src/moderation/index.ts"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "vitest.rules.config.ts", "vitest.e2e.config.ts", "scripts", "tests", "src/**/*.test.ts", "functions/src/**/*.test.ts"]
}
